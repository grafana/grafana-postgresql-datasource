{
    "$schema": "https://raw.githubusercontent.com/grafana/dsconfig/refs/heads/main/dsconfig/schema.json",
    "schemaVersion": "v1",
    "pluginType": "grafana-postgresql-datasource",
    "pluginName": "PostgreSQL",
    "docURL": "https://grafana.com/docs/grafana/latest/datasources/postgres/",
    "fields": [
        {
            "id": "root.url",
            "key": "url",
            "label": "Host URL",
            "description": "PostgreSQL host and port.",
            "valueType": "string",
            "target": "root",
            "required": true,
            "ui": {
                "component": "input",
                "placeholder": "localhost:5432"
            }
        },
        {
            "id": "jsonData.database",
            "key": "database",
            "label": "Database name",
            "description": "PostgreSQL database name.",
            "valueType": "string",
            "target": "jsonData",
            "ui": {
                "component": "input",
                "placeholder": "Database"
            }
        },
        {
            "id": "root.user",
            "key": "user",
            "label": "Username",
            "description": "Database username.",
            "valueType": "string",
            "target": "root",
            "required": true,
            "ui": {
                "component": "input",
                "placeholder": "Username"
            }
        },
        {
            "id": "secureJsonData.password",
            "key": "password",
            "label": "Password",
            "description": "Database password.",
            "valueType": "string",
            "semanticType": "password",
            "target": "secureJsonData"
        },
        {
            "id": "jsonData.sslmode",
            "key": "sslmode",
            "label": "TLS/SSL Mode",
            "description": "Determines whether or with what priority a secure TLS/SSL TCP/IP connection will be negotiated with the server.",
            "valueType": "string",
            "target": "jsonData",
            "defaultValue": "require",
            "validations": [
                {
                    "type": "allowedValues",
                    "values": [
                        "disable",
                        "require",
                        "verify-ca",
                        "verify-full"
                    ]
                }
            ],
            "ui": {
                "component": "select",
                "options": [
                    {
                        "label": "disable",
                        "value": "disable"
                    },
                    {
                        "label": "require",
                        "value": "require"
                    },
                    {
                        "label": "verify-ca",
                        "value": "verify-ca"
                    },
                    {
                        "label": "verify-full",
                        "value": "verify-full"
                    }
                ]
            }
        },
        {
            "id": "jsonData.tlsConfigurationMethod",
            "key": "tlsConfigurationMethod",
            "label": "TLS/SSL Method",
            "description": "How TLS/SSL certificates are configured. File system path specifies paths to certificates on the local file system. Certificate content stores certificate data encrypted in Grafana's database.",
            "valueType": "string",
            "target": "jsonData",
            "defaultValue": "file-path",
            "dependsOn": "jsonData.sslmode != 'disable'",
            "validations": [
                {
                    "type": "allowedValues",
                    "values": [
                        "file-path",
                        "file-content"
                    ]
                }
            ],
            "ui": {
                "component": "select",
                "options": [
                    {
                        "label": "File system path",
                        "value": "file-path"
                    },
                    {
                        "label": "Certificate content",
                        "value": "file-content"
                    }
                ]
            }
        },
        {
            "id": "jsonData.tlsSkipVerify",
            "key": "tlsSkipVerify",
            "label": "Skip TLS Verification",
            "description": "When enabled, skips verification of the PostgreSQL server's TLS certificate chain and host name.",
            "valueType": "boolean",
            "target": "jsonData",
            "ui": {
                "component": "switch"
            }
        },
        {
            "id": "jsonData.sslRootCertFile",
            "key": "sslRootCertFile",
            "label": "TLS/SSL Root Certificate",
            "description": "Path to the root certificate file. Required if TLS/SSL mode is verify-ca or verify-full.",
            "valueType": "string",
            "target": "jsonData",
            "dependsOn": "jsonData.sslmode != 'disable' && jsonData.tlsConfigurationMethod != 'file-content'",
            "ui": {
                "component": "input",
                "placeholder": "TLS/SSL root cert file"
            }
        },
        {
            "id": "jsonData.sslCertFile",
            "key": "sslCertFile",
            "label": "TLS/SSL Client Certificate",
            "description": "Path to the client certificate file for TLS/SSL client authentication.",
            "valueType": "string",
            "target": "jsonData",
            "dependsOn": "jsonData.sslmode != 'disable' && jsonData.tlsConfigurationMethod != 'file-content'",
            "ui": {
                "component": "input",
                "placeholder": "TLS/SSL client cert file"
            }
        },
        {
            "id": "jsonData.sslKeyFile",
            "key": "sslKeyFile",
            "label": "TLS/SSL Client Key",
            "description": "Path to the client key file for TLS/SSL client authentication.",
            "valueType": "string",
            "target": "jsonData",
            "dependsOn": "jsonData.sslmode != 'disable' && jsonData.tlsConfigurationMethod != 'file-content'",
            "ui": {
                "component": "input",
                "placeholder": "TLS/SSL client key file"
            }
        },
        {
            "id": "jsonData.servername",
            "key": "servername",
            "label": "TLS/SSL Server name",
            "description": "Server name used to verify the hostname on the returned TLS certificate.",
            "valueType": "string",
            "target": "jsonData"
        },
        {
            "id": "jsonData.encrypt",
            "key": "encrypt",
            "label": "Encrypt",
            "description": "Determines whether or how the connection to the server is encrypted.",
            "valueType": "string",
            "target": "jsonData"
        },
        {
            "id": "secureJsonData.tlsClientCert",
            "key": "tlsClientCert",
            "label": "TLS/SSL Client Certificate",
            "description": "PEM-encoded client certificate content.",
            "valueType": "string",
            "target": "secureJsonData",
            "dependsOn": "jsonData.sslmode != 'disable' && jsonData.tlsConfigurationMethod == 'file-content'",
            "ui": {
                "component": "textarea",
                "rows": 7
            }
        },
        {
            "id": "secureJsonData.tlsCACert",
            "key": "tlsCACert",
            "label": "TLS/SSL Root Certificate",
            "description": "PEM-encoded root CA certificate content. Required for verify-ca and verify-full modes.",
            "valueType": "string",
            "target": "secureJsonData",
            "dependsOn": "jsonData.sslmode != 'disable' && jsonData.tlsConfigurationMethod == 'file-content'",
            "ui": {
                "component": "textarea",
                "rows": 7
            }
        },
        {
            "id": "secureJsonData.tlsClientKey",
            "key": "tlsClientKey",
            "label": "TLS/SSL Client Key",
            "description": "PEM-encoded client private key content.",
            "valueType": "string",
            "semanticType": "token",
            "target": "secureJsonData",
            "dependsOn": "jsonData.sslmode != 'disable' && jsonData.tlsConfigurationMethod == 'file-content'",
            "ui": {
                "component": "textarea",
                "rows": 7
            }
        },
        {
            "id": "jsonData.timescaledb",
            "key": "timescaledb",
            "label": "TimescaleDB",
            "description": "TimescaleDB is a time-series database built as a PostgreSQL extension. If enabled, Grafana will use time_bucket in the $__timeGroup macro and display TimescaleDB specific aggregate functions in the query builder.",
            "valueType": "boolean",
            "target": "jsonData",
            "ui": {
                "component": "switch"
            }
        },
        {
            "id": "jsonData.timeInterval",
            "key": "timeInterval",
            "label": "Min time interval",
            "description": "A lower limit for the auto group by time interval. Recommended to be set to write frequency, for example 1m if your data is written every minute.",
            "valueType": "string",
            "semanticType": "duration",
            "target": "jsonData",
            "ui": {
                "component": "input",
                "placeholder": "1m"
            }
        },
        {
            "id": "jsonData.timezone",
            "key": "timezone",
            "label": "Session timezone",
            "description": "Specify the timezone used in the database session, such as Europe/Berlin or +02:00.",
            "valueType": "string",
            "target": "jsonData",
            "ui": {
                "component": "input",
                "placeholder": "Europe/Berlin or +02:00"
            }
        },
        {
            "id": "jsonData.authenticationType",
            "key": "authenticationType",
            "label": "Authentication type",
            "description": "The authentication method used to connect to the database.",
            "valueType": "string",
            "target": "jsonData"
        },
        {
            "id": "jsonData.allowCleartextPasswords",
            "key": "allowCleartextPasswords",
            "label": "Allow Cleartext Passwords",
            "description": "Allows using the cleartext client side plugin if required by an account.",
            "valueType": "boolean",
            "target": "jsonData",
            "ui": {
                "component": "switch"
            }
        },
        {
            "id": "jsonData.maxOpenConns",
            "key": "maxOpenConns",
            "label": "Max open",
            "description": "Maximum number of open connections to the database. Default is 100.",
            "valueType": "number",
            "target": "jsonData",
            "defaultValue": 100,
            "validations": [
                {
                    "type": "range",
                    "min": 0
                }
            ]
        },
        {
            "id": "jsonData.maxIdleConns",
            "key": "maxIdleConns",
            "label": "Max idle",
            "description": "Maximum number of idle connections in the connection pool.",
            "valueType": "number",
            "target": "jsonData",
            "validations": [
                {
                    "type": "range",
                    "min": 0
                }
            ]
        },
        {
            "id": "jsonData.connMaxLifetime",
            "key": "connMaxLifetime",
            "label": "Max lifetime",
            "description": "Maximum lifetime of a connection in seconds. Default is 14400 (4 hours). Set to 0 to reuse connections forever.",
            "valueType": "number",
            "target": "jsonData",
            "defaultValue": 14400,
            "validations": [
                {
                    "type": "range",
                    "min": 0
                }
            ]
        },
        {
            "id": "jsonData.connectionTimeout",
            "key": "connectionTimeout",
            "label": "Connection timeout",
            "description": "The number of seconds to wait before aborting attempts to connect to the database.",
            "valueType": "number",
            "target": "jsonData",
            "validations": [
                {
                    "type": "range",
                    "min": 0
                }
            ]
        },
        {
            "id": "jsonData.enableSecureSocksProxy",
            "key": "enableSecureSocksProxy",
            "label": "Enable Secure Socks Proxy",
            "description": "Enables proxying the datasource connection through the secure socks proxy.",
            "valueType": "boolean",
            "target": "jsonData",
            "ui": {
                "component": "switch"
            }
        },
        {
            "id": "jsonData.secureSocksProxyUsername",
            "key": "secureSocksProxyUsername",
            "label": "Secure Socks Proxy username",
            "description": "Username used to authenticate with the secure socks proxy.",
            "valueType": "string",
            "target": "jsonData",
            "dependsOn": "jsonData.enableSecureSocksProxy == true"
        }
    ],
    "groups": [
        {
            "id": "connection",
            "title": "Connection",
            "fieldRefs": [
                "root.url",
                "jsonData.database"
            ]
        },
        {
            "id": "auth",
            "title": "Authentication",
            "fieldRefs": [
                "root.user",
                "secureJsonData.password",
                "jsonData.authenticationType",
                "jsonData.allowCleartextPasswords"
            ]
        },
        {
            "id": "tls",
            "title": "TLS/SSL Settings",
            "fieldRefs": [
                "jsonData.sslmode",
                "jsonData.tlsConfigurationMethod",
                "jsonData.tlsSkipVerify",
                "jsonData.servername",
                "jsonData.encrypt",
                "jsonData.sslRootCertFile",
                "jsonData.sslCertFile",
                "jsonData.sslKeyFile",
                "secureJsonData.tlsClientCert",
                "secureJsonData.tlsCACert",
                "secureJsonData.tlsClientKey"
            ]
        },
        {
            "id": "postgres-options",
            "title": "PostgreSQL Options",
            "fieldRefs": [
                "jsonData.timezone",
                "jsonData.timeInterval",
                "jsonData.timescaledb"
            ]
        },
        {
            "id": "connection-limits",
            "title": "Connection limits",
            "fieldRefs": [
                "jsonData.maxOpenConns",
                "jsonData.maxIdleConns",
                "jsonData.connMaxLifetime",
                "jsonData.connectionTimeout"
            ]
        },
        {
            "id": "proxy",
            "title": "Secure Socks Proxy",
            "fieldRefs": [
                "jsonData.enableSecureSocksProxy",
                "jsonData.secureSocksProxyUsername"
            ]
        }
    ],
    "relationships": [
        {
            "type": "pair",
            "fields": [
                "root.user",
                "secureJsonData.password"
            ],
            "description": "Database credentials"
        },
        {
            "type": "pair",
            "fields": [
                "secureJsonData.tlsClientCert",
                "secureJsonData.tlsClientKey"
            ],
            "description": "TLS client certificate and key"
        }
    ]
}
