{
  "type": "datasource",
  "name": "PostgreSQL",
  "id": "grafana-postgresql-datasource",
  "aliasIDs": [
    "postgres"
  ],
  "category": "sql",
  "executable": "gpx_grafana_postgresql_datasource",
  "alerting": true,
  "annotations": true,
  "metrics": true,
  "logs": true,
  "backend": true,
  "queryOptions": {
    "minInterval": true
  },
  "info": {
    "description": "Data source for PostgreSQL and compatible databases",
    "keywords": [
      "postgresql",
      "postgres",
      "sql",
      "database"
    ],
    "author": {
      "name": "Grafana Labs",
      "url": "https://grafana.com"
    },
    "logos": {
      "small": "img/postgresql_logo.svg",
      "large": "img/postgresql_logo.svg"
    },
    "version": "%VERSION%",
    "updated": "%TODAY%",
    "links": [
      {
        "name": "Raise issue",
        "url": "https://github.com/grafana/grafana-postgresql-datasource/issues/new"
      },
      {
        "name": "Documentation",
        "url": "https://grafana.com/docs/plugins/grafana-postgresql-datasource/latest"
      }
    ]
  },
  "dependencies": {
    "grafanaDependency": ">=12.3.0",
    "plugins": []
  }
}
